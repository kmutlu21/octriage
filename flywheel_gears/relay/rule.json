{
  "name": "relay: volumes tagged ai-ready",
  "triggering_input": "volume",
  "config": {
    "service_url": "http://gpu-host:8000",
    "done_tag": "relay-done"
  },
  "auto_update": false,
  "all": [
    {"type": "file.tags", "value": "ai-ready", "regex": false}
